DJANGO_SECRET_KEY=replace-with-a-random-local-secret
DJANGO_DEBUG=1
# Mettre 0 pour suspendre temporairement la vérification en développement local.
REQUIRE_EMAIL_VERIFICATION=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
POSTGRES_DB=qavelys
POSTGRES_USER=qavelys
POSTGRES_PASSWORD=replace-with-a-local-database-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# PostgreSQL distant/Supabase : require, ou verify-full avec certificat CA.
# Laisser vide pour PostgreSQL local uniquement.
POSTGRES_SSLMODE=
POSTGRES_SSLROOTCERT=
# 1 uniquement avec pooler transaction (pas pour les migrations).
POSTGRES_TRANSACTION_POOLER=0
EMAIL_BACKEND=django.core.mail.backends.filebased.EmailBackend
# SMTP de production : renseigner le fournisseur et choisir STARTTLS ou TLS implicite.
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=0
EMAIL_USE_SSL=0
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=noreply@localhost
FRONTEND_URL=http://localhost:5173
